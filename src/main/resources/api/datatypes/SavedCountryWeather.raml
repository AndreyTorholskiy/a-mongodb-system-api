#%RAML 1.0 DataType
displayName: Save Country Weather Response
description: The response structure returned by the DB System API after a successful upsert operation.

type: object
properties:
  message:
    type: string
    example: "Save Country Weather: DB updated"
    required: true
  upsertedDocument:
    displayName: Upserted Document
    description: The final document saved in the NoSQL database
    type: object
    properties:
      country:
        type: string
      countryCode:
        type: string
      region:
        type: string
      subregion:
        type: string
      population:
        type: integer
      timezone:
        type: integer
      currencies:
        type: object
      languages:
        type: object
      capital:
        type: object
        properties:
          city:
            type: string
          longitude:
            type: number
          latitude:
            type: number
          seaLevel:
            type: integer
            required: false
          weatherConditions:
            type: object
            properties:
              visibility:
                type: integer
              temperature:
                type: object
                properties:
                  degrees:
                    type: string
                    enum: [Celsius, Fahrenheit, Kelvin]
                  current:
                    type: number
                  max:
                    type: number
                  min:
                    type: number
          sunrise:
            type: integer
          sunset:
            type: integer
          weatherOn:
            type: datetime
            description: Timestamp of when the weather data was captured or stored